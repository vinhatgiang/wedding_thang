#!/bin/sh

# Pre-commit hook to prevent direct commits to develop branch
# Get the current branch name
BRANCH=$(git symbolic-ref --short HEAD)

# Check if the current branch is develop
if [ "$BRANCH" = "develop" ]; then
    echo "ERROR: Direct commits to the develop branch are not allowed."
    echo "Please create a feature branch and submit a pull request instead."
    exit 1
fi

exit 0
