#!/bin/sh
# Git Hook: commit-msg
#
# This hook validates the commit message provided by the user.
# It checks for minimum length and enforces Conventional Commits format.

# --- UTILITY: Cross-Platform Error Dialog ---
show_error() {
    message="$1"
    title="Git Hook Error: Invalid Commit Message"

    case "$(uname -s)" in
        Darwin)
            # For AppleScript, we need to escape backslashes and double quotes.
            escaped_message=$(echo "$message" | sed 's/\\/\\\\/g; s/"/\\"/g')
            osascript -e "display dialog \"$escaped_message\" with title \"$title\" with icon stop buttons {\"OK\"} default button \"OK\"" >/dev/null
            ;;
        CYGWIN*|MINGW*|MSYS*)
            # For PowerShell, we need to escape single quotes by doubling them up.
            escaped_message=$(echo "$message" | sed "s/'/''/g")
            powershell.exe -Command "Add-Type -AssemblyName PresentationFramework; [System.Windows.MessageBox]::Show('$escaped_message', '$title', 'OK', 'Error')"
            ;;
        *)
            # Fallback for other systems (like Linux) or when dialogs fail
            printf "\n\033[31m%s\n%s\033[0m\n\n" "$title" "$message"s
            ;;
    esac
}

# --- LOGIC ---

# Git passes the path to the temporary file containing the commit message as the first argument.
COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# 1. Validate length
if [ ${#COMMIT_MSG} -lt 10 ]; then
    show_error "Commit message is too short (minimum 10 characters). Your message was: \"$COMMIT_MSG\""
    exit 1
fi

exit 0 