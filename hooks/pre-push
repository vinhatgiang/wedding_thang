#!/bin/sh
# Git Hook: pre-push
#
# Prevents pushes to protected branches and blocks force pushes.

# --- UTILITY: Cross-Platform Error Dialog ---
show_error() {
    message="$1"
    title="Git Hook Error: pre-push"

    case "$(uname -s)" in
        Darwin)
            # For AppleScript, we need to escape backslashes and double quotes.
            escaped_message=$(echo "$message" | sed 's/\\/\\\\/g; s/"/\\"/g')
            osascript -e "display dialog \"$escaped_message\" with title \"$title\" with icon stop buttons {\"OK\"} default button \"OK\"" >/dev/null
            ;;
        CYGWIN*|MINGW*|MSYS*)
            # For PowerShell, we need to escape single quotes by doubling them up.
            escaped_message=$(echo "$message" | sed "s/'/''/g")
            powershell.exe -Command "Add-Type -AssemblyName PresentationFramework; [System.Windows.MessageBox]::Show('$escaped_message', '$title', 'OK', 'Error')"
            ;;
        *)
            printf "\n\033[31m%s\n%s\033[0m\n\n" "$title" "$message"
            ;;
    esac
}

# --- LOGIC ---

# Read details of the push from standard input.
while read -r local_ref local_sha remote_ref remote_sha; do

    # 1. Block pushes to protected branches
    remote_branch=$(echo "$remote_ref" | cut -d'/' -f3)
    if [ "$remote_branch" = "main" ] || [ "$remote_branch" = "develop" ]; then
        show_error "Direct pushes to the '$remote_branch' branch are forbidden. Please use a pull request."
        exit 1
    fi

    # 2. Block force pushes (non-fast-forward updates)
    zero_commit="0000000000000000000000000000000000000000"
    if [ "$remote_sha" != "$zero_commit" ]; then
        merge_base=$(git merge-base "$local_sha" "$remote_sha")
        if [ "$merge_base" != "$remote_sha" ]; then
            show_error "Force pushing is not allowed. The remote branch has changes you do not have locally. Please pull first."
            exit 1
        fi
    fi

done

exit 0 